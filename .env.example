# ---------------------------------------------------------------- WordPress
# Fuente editorial. Ya funciona sin nada más.
NEXT_PUBLIC_WP_API_URL=https://tubarco.news/wp-json/wp/v2
NEXT_PUBLIC_SITE_URL=https://tubarco.news

# ---------------------------------------------------------------- Supabase
# Capa de cuentas, guardados y contadores (TuBarco Inteligente).
# Se sacan de: panel de Supabase → Project Settings → API
#
# Mientras estén vacías, el sitio funciona igual: las noticias no dependen de
# esto. Solo quedan ocultas las funciones que necesitan cuenta.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Llave de servicio: SOLO servidor. Nunca con prefijo NEXT_PUBLIC_ ni en el
# repositorio — se salta las políticas de acceso por fila.
SUPABASE_SERVICE_ROLE_KEY=
